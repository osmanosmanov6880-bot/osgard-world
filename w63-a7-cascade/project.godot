; Godot 4.4.1 experimental stand-alone cascading systems prototype.
; Original OSGARD/W61 six-mission simulator remains completely untouched.
config_version=5

[application]
config/name="A7 CASCADE | LAST FRONTIER EXPERIMENTAL PLAYTEST"
config/description="Fictional choice-and-consequence systems puzzle; not real industrial advice."
run/main_scene="res://Main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
environment/defaults/default_clear_color=Color(0.023, 0.04, 0.058, 1)

[gui]
theme/default_theme_scale=1.0
