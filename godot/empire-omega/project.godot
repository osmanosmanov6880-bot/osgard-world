; OSGARD EMPIRE Ω / Godot 4.x
; Original city game preserved; OSMAN: WORLD DOMINION is an additive gameplay system.
config_version=5

[application]
config/name="OSMAN: WORLD DOMINION — ОСМАН: МИРОВОЕ ГОСПОДСТВО"
run/main_scene="res://scenes/main.tscn"
config/description="FROM THE CASPIAN TO THE WORLD. Russian-first 3D city game, governance and dynasty."

[autoload]
GameState="*res://scripts/game_state.gd"
MissionManager="*res://scripts/mission_manager.gd"
ContractManager="*res://scripts/contract_manager.gd"
GameSettings="*res://scripts/game_settings.gd"
OsmanDynasty="*res://scripts/osman_dynasty.gd"
OsmanGamePanel="*res://scripts/osman_game_panel.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/default_gravity=24.0

[application/config]
features=PackedStringArray("4.2", "GL Compatibility")
