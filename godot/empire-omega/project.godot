; OSGARD EMPIRE OMEGA / Godot 4.x
; Generated source, no third-party artwork or assets.
config_version=5

[application]
config/name="CITY REIGN — Open World Prototype"
run/main_scene="res://scenes/main.tscn"
config/description="CITY REIGN: open-world city driving, missions and strategic city governance"

[autoload]
GameState="*res://scripts/game_state.gd"
MissionManager="*res://scripts/mission_manager.gd"
ContractManager="*res://scripts/contract_manager.gd"
GameSettings="*res://scripts/game_settings.gd"

[display]
; Square design base preserves desktop 16:9 via EXPAND and exposes true
; portrait scene area instead of letterboxing 1600x900 into a 390px strip.
window/size/viewport_width=900
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/default_gravity=24.0

[application/config]
features=PackedStringArray("4.2", "GL Compatibility")
