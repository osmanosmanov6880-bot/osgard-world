extends Node
## Original synthesized audio generated by tools/generate_audio.py. No stock
## loops, copyrighted music or cloud services required. Master volume uses
## existing GameSettings. This is an audio prototype, not studio sound design.
const AMBIENCE_PATH = "res://assets/audio/city_air.wav"
const ENGINE_PATH = "res://assets/audio/engine_low.wav"
const RAIN_PATH = "res://assets/audio/rain.wav"
const SUCCESS_PATH = "res://assets/audio/ui_success.wav"
const PATROL_PATH = "res://assets/audio/patrol_alert.wav"
var ambience: AudioStreamPlayer
var engine: AudioStreamPlayer3D
var rain: AudioStreamPlayer
var success: AudioStreamPlayer
var pursuit: AudioStreamPlayer

func _load_loop(path: String) -> AudioStream:
	var original: AudioStreamWAV = load(path) as AudioStreamWAV
	if original == null:
		push_warning("OSGARD sound asset not imported: " + path)
		return null
	var cloned: AudioStreamWAV = original.duplicate() as AudioStreamWAV
	cloned.loop_mode = AudioStreamWAV.LOOP_FORWARD
	return cloned

func _ready() -> void:
	ambience = AudioStreamPlayer.new()
	ambience.name = "UrbanAmbience"
	ambience.volume_db = -26.0
	ambience.stream = _load_loop(AMBIENCE_PATH)
	add_child(ambience)
	if ambience.stream != null: ambience.play()
	engine = AudioStreamPlayer3D.new()
	engine.name = "VehicleEngine"
	engine.unit_size = 7.0
	engine.max_distance = 120.0
	engine.volume_db = -55.0
	engine.stream = _load_loop(ENGINE_PATH)
	add_child(engine)
	rain = AudioStreamPlayer.new()
	rain.name = "WeatherRain"
	rain.volume_db = -65.0
	rain.stream = _load_loop(RAIN_PATH)
	add_child(rain)
	success = AudioStreamPlayer.new()
	success.name = "MissionSuccess"
	success.volume_db = -19.0
	success.stream = load(SUCCESS_PATH)
	add_child(success)
	pursuit = AudioStreamPlayer.new()
	pursuit.name = "CityPatrolAlert"
	pursuit.volume_db = -65.0
	pursuit.stream = _load_loop(PATROL_PATH)
	add_child(pursuit)

func attach_vehicle(vehicle: Node3D) -> void:
	if engine != null and vehicle != null:
		engine.reparent(vehicle)
		engine.position = Vector3(0,0.6,0)

func update_cues(driving: bool, velocity: float, weather: String, wanted: int = 0) -> void:
	if engine != null:
		if driving and engine.stream != null and not engine.playing: engine.play()
		var desired: float = clampf(-27.0 + absf(velocity)*0.3,-27.0,-16.0) if driving else -65.0
		engine.volume_db = lerpf(engine.volume_db,desired,0.1)
		engine.pitch_scale = clampf(0.72 + absf(velocity)*0.025,0.72,1.48) if driving else 0.72
		if not driving and engine.playing and engine.volume_db < -62.0: engine.stop()
	if rain != null:
		var wet: bool = weather == "rain" or weather == "storm"
		if wet and rain.stream != null and not rain.playing: rain.play()
		rain.volume_db = lerpf(rain.volume_db,-29.0 if wet else -65.0,0.1)
		if not wet and rain.playing and rain.volume_db < -63.0: rain.stop()

	if pursuit != null:
		var active: bool = wanted > 0
		if active and pursuit.stream != null and not pursuit.playing: pursuit.play()
		pursuit.volume_db = lerpf(pursuit.volume_db,-23.0 if active else -65.0,0.08)
		if not active and pursuit.playing and pursuit.volume_db < -63.0: pursuit.stop()

func play_success() -> void:
	if success != null and success.stream != null:
		success.play()
