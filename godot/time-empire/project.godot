; OSGARD WORLD — TIME EMPIRE / CHRONOS CITY
config_version=5

[application]
config/name="ИМПЕРИЯ ВРЕМЕНИ — CHRONOS CITY"
run/main_scene="res://scenes/main.tscn"
config/description="An original 3D city-building strategy vertical slice"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.016,0.03,0.057,1)

[gui]
theme/default_font_size=20