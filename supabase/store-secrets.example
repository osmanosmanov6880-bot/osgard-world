# Template ONLY. DO NOT commit real secret values.
# Set these as Supabase Edge Function Secrets on the chosen project.
# Merchant must be the legally authorized holder of the UK Stripe account.
STRIPE_MODE=live
STRIPE_SECRET_KEY=REPLACE_IN_SUPABASE_DASHBOARD
STRIPE_WEBHOOK_SIGNING_SECRET=REPLACE_IN_SUPABASE_DASHBOARD
MERCHANT_STRIPE_ACCOUNT_ID=REPLACE_WITH_VERIFIED_UK_ACCT_ID
STORE_MERCHANT_LEGAL_NAME=REPLACE_WITH_LEGAL_SELLER_NAME
STORE_ALLOWED_ORIGINS=https://YOUR-STORE-DOMAIN
STORE_SUCCESS_URL=https://YOUR-STORE-DOMAIN/checkout/success?session_id={CHECKOUT_SESSION_ID}
STORE_CANCEL_URL=https://YOUR-STORE-DOMAIN/checkout/cancel
STORE_TERMS_URL=https://YOUR-STORE-DOMAIN/terms
STORE_REFUND_URL=https://YOUR-STORE-DOMAIN/refund-policy
